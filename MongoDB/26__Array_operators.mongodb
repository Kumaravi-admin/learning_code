db.students5.insertMany([
  {
    _id: 1,
    name: "Akshay Kumar",
    subjects: [
      ["Math", 85],
      ["Science", 77],
      ["History", 82],
    ],
  },
  {
    _id: 2,
    name: "Salman Khan",
    subjects: [
      ["Math", 88],
