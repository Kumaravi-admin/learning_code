  {
    _id: 1,
    name: "Akshay Kumar",
    subjects: ["Math", "Science", "History"],
    marks: [85, 77, 82],
  },
  {
    _id: 2,
    name: "Salman Khan",
    subjects: ["Math", "Science", "Music"],
